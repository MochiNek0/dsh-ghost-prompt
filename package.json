{
  "name": "dsh-ghost-prompt",
  "version": "1.1.2",
  "description": "Prompt suggestions for DeepSeek Harness (dsh): after each turn the model predicts your next message and shows it as ghost text in the composer; press → to accept",
  "author": "MochiNek0",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "prompt-suggestion",
    "ghost-text",
    "autocomplete"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MochiNek0/dsh-ghost-prompt.git"
  },
  "homepage": "https://github.com/MochiNek0/dsh-ghost-prompt#readme",
  "bugs": {
    "url": "https://github.com/MochiNek0/dsh-ghost-prompt/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "name": "next-prompt",
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "icon.svg",
    "cordis.patch.yml",
    "locale"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.client.json && node wrap-client.cjs",
    "test": "pnpm run build && node --test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  }
}
